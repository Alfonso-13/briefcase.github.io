{
  "name": "briefcase",
  "version": "0.0.1",
  "author": "Alfonso-13",
  "homepage": "https://github.com/Alfonso-13/briefcase.github.io/",
  "scripts": {
    "ng": "ng",
    "prepare:config": "node scripts/prepare-config.mjs",
    "prestart": "npm run prepare:config",
    "start": "ng serve --host=localhost --port=8100",
    "predebug": "npm run prepare:config",
    "debug": "ng serve --host=localhost --port=8100 --configuration=development",
    "predebug:network": "npm run prepare:config",
    "debug:network": "ng serve --host=0.0.0.0 --port=8100 --configuration=development",
    "predebug:cli": "npm run prepare:config",
    "debug:cli": "node --inspect-brk ./node_modules/@angular/cli/bin/ng.js serve --host=localhost --port=8100 --configuration=development",
    "prepreview": "npm run prepare:config",
    "preview": "ng serve --host=localhost --port=8100 --configuration=production",
    "prebuild": "npm run prepare:config",
    "build": "ng build --configuration=production --base-href=/briefcase.github.io/",
    "prebuild:debug": "npm run prepare:config",
    "build:debug": "ng build --configuration=development --base-href=/briefcase.github.io/ --source-map",
    "deploy:pages": "npm run build && node scripts/deploy-pages.mjs",
    "pretest": "npm run prepare:config",
    "test": "vitest run",
    "lint": "ng lint",
    "verify": "npm run lint && npm test && npm run build",
    "postbuild": "npm run copy:Nojekyll",
    "copy:Nojekyll": "node scripts/copy-nojekyll.mjs",
    "versions": "node --version && npm --version && ng version"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "9.0.10",
    "rxjs": "7.8.2",
    "swiper": "14.4.0",
    "three": "0.187.0",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/cli": "22.2.5",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@eslint/js": "10.0.1",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "13.0.0",
    "@types/node": "26.0.0",
    "@types/three": "0.187.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "description": "Configurable Angular and Ionic portfolio with an interactive Three.js professional universe.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alfonso-13/briefcase.github.io.git"
  },
  "keywords": [
    "portfolio",
    "angular",
    "ionic",
    "threejs",
    "github-pages"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
