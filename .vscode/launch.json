{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Briefcase: Angular + Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:8100",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "briefcase: debug"
    },
    {
      "name": "Briefcase: Attach Chrome",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
