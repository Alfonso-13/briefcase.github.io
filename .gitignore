# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Local portfolio content and personal brand assets. Public forks start from
# src/assets/config.example and generate this directory on first run.
/src/assets/config/
/src/assets/config.local-backup/
/src/assets/img/alfonso-13-brand.png
